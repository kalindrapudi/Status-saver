<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by the Insta / FB browser, the AI website browser and Muse Studio's optional API mode. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app check which AI apps are installed so it can send to them directly. -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.microsoft.copilot" />
        <package android:name="ai.perplexity.app.android" />
        <package android:name="ai.x.grok" />
        <package android:name="com.deepseek.chat" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Status Studio"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".WebSaverActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".AiHubActivity"
            android:exported="false" />

        <activity
            android:name=".AiWebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Muse Studio. Also appears in Android's share sheet for pictures,
             so you can send AI results or Pinterest images straight into it. -->
        <activity
            android:name=".MuseActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:label="Muse Studio"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name=".ShareProvider"
            android:authorities="com.kali.statussaver.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
